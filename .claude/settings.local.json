{
  "permissions": {
    "allow": [
      "Bash(pnpm build *)",
      "Bash(pnpm dev *)",
      "Bash(Start-Process -NoNewWindow pnpm -ArgumentList \"dev\")",
      "Bash(Start-Sleep -Seconds 5)",
      "Bash(Invoke-WebRequest -Uri \"http://localhost:3001/login\" -UseBasicParsing -TimeoutSec 5)",
      "Bash(Select-Object -ExpandProperty StatusCode)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001/login)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_evaluate"
    ]
  }
}
